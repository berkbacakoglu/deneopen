# Shared
NODE_ENV=development
LOG_LEVEL=info
PORT=3001
WEB_PORT=3000
API_BASE_URL=http://127.0.0.1:3001
# Optional: when set, API write routes require x-api-key header
API_WRITE_TOKEN=
# Mobile runtime env (Expo)
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
EXPO_PUBLIC_API_WRITE_TOKEN=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb?schema=public
